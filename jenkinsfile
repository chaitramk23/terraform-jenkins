pipeline {

    parameters {
        booleanParam(name: 'autoApprove', defaultValue: false, description: 'Automatically run apply after generating plan?')
        choice(name: 'region', choices: ['ap-south-1', 'us-east-1', 'us-west-2'], description: 'Select AWS Region')
        choice(name: 'env', choices: ['dev', 'qa', 'staging', 'prod'], description: 'Select Environment')
        choice(name: 'instance_type', choices: ['t2.micro', 't3.micro', 't2.small'], description: 'Select EC2 Instance Type')
    } 

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
    }

    agent any

    stages {
        stage('Checkout') {
            steps {
                script {
                    dir("terraform") {
                        git "https://github.com/chaitramk23/Terraform-Jenkins.git"
                    }
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh "terraform plan -out=tfplan -var region=${params.region} -var env=${params.env} -var instance_type=${params.instance_type}"
                }
            }
        }

        stage('Terraform Show') {
            steps {
                dir('terraform') {
                    sh "terraform show -no-color tfplan > tfplan.txt"
                    // Optional: print plan in console for easier review
                    sh "cat tfplan.txt"
                }
            }
        }

        stage('Approval') {
            when {
                expression { return !params.autoApprove } // fixed manual approval condition
            }
            steps {
                script {
                    def plan = readFile 'terraform/tfplan.txt'
                    input message: "Do you want to apply the plan?",
                          parameters: [text(name: 'Plan', description: 'Please review the plan', defaultValue: plan)]
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh "terraform apply -input=false tfplan"
                }
            }
        }
    }
}
